@code {
    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        StateHasChanged();
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
    }

    private string Active(string href, bool exact = false)
    {
        var path = new Uri(Nav.Uri).AbsolutePath.TrimEnd('/').ToLowerInvariant();
        var target = href.TrimEnd('/').ToLowerInvariant();
        var match = exact ? path == target : (path == target || path.StartsWith(target + "/"));
        return "docs-nav-link" + (match ? " active" : "");
    }
}
