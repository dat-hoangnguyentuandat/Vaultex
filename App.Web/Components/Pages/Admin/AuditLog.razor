@page "/admin/audit"
@layout AdminLayout
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@rendermode InteractiveServer

<PageTitle>Audit Log</PageTitle>

<h3>Audit Log</h3>

<div class="row g-2 mb-3">
    <div class="col-md-3">
        <input class="form-control" placeholder="Event type..." @bind="filterEvent" @bind:event="oninput" />
    </div>
    <div class="col-md-3">
        <input type="date" class="form-control" @bind="filterFrom" />
    </div>
    <div class="col-md-3">
        <input type="date" class="form-control" @bind="filterTo" />
    </div>
    <div class="col-md-3">
        <button class="btn btn-outline-primary w-100" @onclick="LoadLogs">Search</button>
    </div>
</div>

@if (loading)
{
    <p>Loading...</p>
}
else
{
    <table class="table table-sm table-hover font-monospace">
        <thead>
            <tr>
                <th>Timestamp</th>
                <th>Event</th>
                <th>User ID</th>
                <th>Resource</th>
                <th>IP</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var e in logs)
            {
                <tr @onclick="() => selected = e" style="cursor:pointer"
                    class="@(selected?.Id == e.Id ? "table-active" : "")">
                    <td>@e.Timestamp.ToString("dd/MM/yyyy HH:mm:ss")</td>
                    <td><span class="badge @BadgeClass(e.EventType)">@e.EventType</span></td>
                    <td class="text-truncate" style="max-width:120px">@e.UserId</td>
                    <td>@e.ResourceType @e.ResourceId</td>
                    <td>@e.IpAddress</td>
                </tr>
            }
        </tbody>
    </table>

    <div class="d-flex gap-2 align-items-center">
        <button class="btn btn-sm btn-outline-secondary" disabled="@(page <= 1)" @onclick="PrevPage">‹ Prev</button>
        <span>Page @(page) — @total total events</span>
        <button class="btn btn-sm btn-outline-secondary" disabled="@(page >= totalPages)" @onclick="NextPage">Next ›</button>
    </div>
}

@if (selected is not null)
{
    <div class="card mt-3">
        <div class="card-header d-flex justify-content-between">
            <span>Event Detail</span>
            <button class="btn-close" @onclick="() => selected = null"></button>
        </div>
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-3">ID</dt><dd class="col-9">@selected.Id</dd>
                <dt class="col-3">Event</dt><dd class="col-9">@selected.EventType</dd>
                <dt class="col-3">Tenant</dt><dd class="col-9">@selected.TenantId</dd>
                <dt class="col-3">User</dt><dd class="col-9">@selected.UserId</dd>
                <dt class="col-3">Resource</dt><dd class="col-9">@selected.ResourceType / @selected.ResourceId</dd>
                <dt class="col-3">IP</dt><dd class="col-9">@selected.IpAddress</dd>
                <dt class="col-3">Timestamp</dt><dd class="col-9">@selected.Timestamp.ToString("o")</dd>
                    @if (!string.IsNullOrEmpty(selected.OldValue))
                    {
                        <dt class="col-3">Old Value</dt>
                        <dd class="col-9"><code class="text-break">@selected.OldValue</code></dd>
                    }
                    @if (!string.IsNullOrEmpty(selected.NewValue))
                    {
                        <dt class="col-3">New Value</dt>
                        <dd class="col-9"><code class="text-break">@selected.NewValue</code></dd>
                    }
            </dl>
        </div>
    </div>
}

@code {
    [Inject] private global::App.Web.Services.ApiClient Api { get; set; } = default!;

    private List<AuditDto> logs = [];
    private AuditDto? selected;
    private bool loading = true;
    private int page = 1, totalPages = 1, total;
    private const int PageSize = 50;
    private string filterEvent = "";
    private DateTime? filterFrom, filterTo;

    protected override async Task OnInitializedAsync() => await LoadLogs();

    private async Task LoadLogs()
    {
        loading = true;
        var url = $"api/audit?page={page}&pageSize={PageSize}";
        if (!string.IsNullOrEmpty(filterEvent)) url += $"&eventType={Uri.EscapeDataString(filterEvent)}";
        if (filterFrom.HasValue) url += $"&dateFrom={filterFrom.Value:yyyy-MM-dd}";
        if (filterTo.HasValue) url += $"&dateTo={filterTo.Value:yyyy-MM-dd}";

        var result = await Api.CallApiAsync<PagedResult<AuditDto>>(url);
        logs = result?.Items ?? [];
        total = result?.Total ?? 0;
        totalPages = total == 0 ? 1 : (int)Math.Ceiling(total / (double)PageSize);
        loading = false;
    }

    private async Task PrevPage() { page--; await LoadLogs(); }
    private async Task NextPage() { page++; await LoadLogs(); }

    private static string BadgeClass(string eventType) => eventType switch
    {
        "LOGIN_SUCCESS"          => "bg-success",
        "LOGIN_FAILED"           => "bg-danger",
        "LOGOUT"                 => "bg-secondary",
        "ACCESS_DENIED"          => "bg-warning text-dark",
        "REGISTER"               => "bg-primary",
        "EMAIL_CONFIRMED"        => "bg-success",
        "PASSWORD_RESET"         => "bg-warning text-dark",
        "PASSWORD_CHANGED"       => "bg-warning text-dark",
        "PROFILE_UPDATED"        => "bg-info text-dark",
        "USER_CREATED"           => "bg-primary",
        "USER_DELETED"           => "bg-danger",
        "USER_STATUS_CHANGED"    => "bg-warning text-dark",
        "ROLE_CHANGED"           => "bg-info text-dark",
        "POLICY_CHANGED"         => "bg-info text-dark",
        "TENANT_CREATED"         => "bg-primary",
        "TENANT_UPDATED"         => "bg-info text-dark",
        "TENANT_STATUS_CHANGED"  => "bg-warning text-dark",
        "PRODUCT_CREATED"        => "bg-primary",
        "PRODUCT_UPDATED"        => "bg-info text-dark",
        "PRODUCT_DELETED"        => "bg-danger",
        _                        => "bg-secondary"
    };

    private record PagedResult<T>(int Total, int Page, int PageSize, List<T> Items);
    private record AuditDto(Guid Id, Guid? TenantId, Guid? UserId, string EventType,
        string? ResourceType, string? ResourceId, string? IpAddress, DateTime Timestamp,
        string? OldValue, string? NewValue);
}
