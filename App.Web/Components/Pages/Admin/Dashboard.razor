@page "/admin"
@layout AdminLayout
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@rendermode InteractiveServer

<PageTitle>Dashboard — Vaultex Admin</PageTitle>

<div class="dash-header">
    <div>
        <div class="dash-title">Dashboard</div>
        <div class="dash-subtitle">@tenantName</div>
    </div>
</div>

<div class="dash-stats">
    <a href="/admin/users" class="dash-stat-card">
        <div class="dash-stat-icon dash-stat-icon--blue">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
                <path d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"/>
            </svg>
        </div>
        <div class="dash-stat-body">
            <div class="dash-stat-value">@userCount</div>
            <div class="dash-stat-label">Users</div>
        </div>
        <div class="dash-stat-arrow">→</div>
    </a>

    <a href="/admin/roles" class="dash-stat-card">
        <div class="dash-stat-icon dash-stat-icon--purple">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm0 10.99h7c-.53 4.12-3.28 7.79-7 8.94V12H5V6.3l7-3.11v8.8z"/>
            </svg>
        </div>
        <div class="dash-stat-body">
            <div class="dash-stat-value">@roleCount</div>
            <div class="dash-stat-label">Roles</div>
        </div>
        <div class="dash-stat-arrow">→</div>
    </a>

    <a href="/admin/policies" class="dash-stat-card">
        <div class="dash-stat-icon dash-stat-icon--green">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
                <path d="M14 2H6c-1.1 0-2 .9-2 2v16c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V8l-6-6zm-1 7V3.5L18.5 9H13zm-2 8l-3-3 1.41-1.41L10 14.17l4.59-4.58L16 11l-6 6z"/>
            </svg>
        </div>
        <div class="dash-stat-body">
            <div class="dash-stat-value">@policyCount</div>
            <div class="dash-stat-label">Policies</div>
        </div>
        <div class="dash-stat-arrow">→</div>
    </a>

    <a href="/admin/audit" class="dash-stat-card">
        <div class="dash-stat-icon dash-stat-icon--orange">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
                <path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 3c1.93 0 3.5 1.57 3.5 3.5S13.93 13 12 13s-3.5-1.57-3.5-3.5S10.07 6 12 6zm7 13H5v-.23c0-.62.28-1.2.76-1.58C7.47 15.82 9.64 15 12 15s4.53.82 6.24 2.19c.48.38.76.97.76 1.58V19z"/>
            </svg>
        </div>
        <div class="dash-stat-body">
            <div class="dash-stat-value">@auditCount</div>
            <div class="dash-stat-label">Audit Events</div>
        </div>
        <div class="dash-stat-arrow">→</div>
    </a>
</div>

