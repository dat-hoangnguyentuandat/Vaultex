@inherits LayoutComponentBase
@inject ThemeService Theme
@implements IDisposable

<div class="docs-shell">
    <header class="docs-topbar">
        <a href="/docs" class="docs-topbar-brand">
            <div class="docs-topbar-brand-logo">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4z" />
                </svg>
            </div>
            <span>Vaultex</span>
            <span class="docs-topbar-brand-tag">Docs</span>
        </a>

        <nav class="docs-topbar-nav">
            <a href="/docs" class="@TopActive("")">Documentation</a>
            <a href="/docs/api-reference" class="@TopActive("api-reference")">API Reference</a>
            <a href="/docs/guides" class="@TopActive("guides")">Guides</a>
            <a href="/docs/changelog" class="@TopActive("changelog")">Changelog</a>
        </nav>

        <div class="docs-topbar-actions">
            <div class="docs-search">
                <span class="docs-search-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M15.5 14h-.79l-.28-.27a6.5 6.5 0 1 0-.7.7l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z" />
                    </svg>
                </span>
                <input type="text" placeholder="Search docs..." />
                <span class="docs-search-kbd">Ctrl K</span>
            </div>

            <button class="docs-topbar-iconbtn" @onclick="Theme.ToggleAsync" title="Toggle theme">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 3a9 9 0 1 0 9 9c0-.46-.04-.92-.1-1.36a5.389 5.389 0 0 1-4.4 2.26 5.403 5.403 0 0 1-3.14-9.8c-.44-.06-.9-.1-1.36-.1z" />
                </svg>
            </button>

            <a href="https://github.com" target="_blank" class="docs-topbar-iconbtn" title="GitHub">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2c-3.3.7-4-1.6-4-1.6-.6-1.4-1.4-1.8-1.4-1.8-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.7-1.6-2.7-.3-5.5-1.3-5.5-6 0-1.2.5-2.3 1.3-3.1-.2-.4-.6-1.6 0-3.2 0 0 1-.3 3.4 1.2a11.5 11.5 0 0 1 6 0c2.3-1.5 3.3-1.2 3.3-1.2.6 1.6.2 2.8.1 3.2.7.8 1.2 1.9 1.2 3.1 0 4.6-2.8 5.6-5.5 5.9.5.4.9 1 .9 2.2v3.3c0 .3.1.7.8.6A12 12 0 0 0 12 .3" />
                </svg>
            </a>

            <a href="/" class="docs-topbar-iconbtn" title="Home">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z" />
                </svg>
            </a>
        </div>
    </header>

    <div class="docs-main">
        <aside class="docs-sidebar">
            <DocsNav />
        </aside>

        <main class="docs-content">
            @Body
        </main>

        <aside class="docs-toc">
            @* TOC populated per page via PageToc cascading or page-level markup *@
        </aside>
    </div>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>

@code {
    [Inject] private NavigationManager Nav { get; set; } = default!;

    private string TopActive(string segment)
    {
        var path = new Uri(Nav.Uri).AbsolutePath.TrimEnd('/').ToLowerInvariant();
        if (string.IsNullOrEmpty(segment))
            return path == "/docs" ? "active" : "";
        return path.Contains($"/docs/{segment}", StringComparison.Ordinal) ? "active" : "";
    }

    protected override void OnInitialized()
    {
        Theme.OnChange += StateHasChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Theme.InitAsync();
            StateHasChanged();
        }
    }

    public void Dispose()
    {
        Theme.OnChange -= StateHasChanged;
    }
}
