@page "/admin/users"
@layout AdminLayout
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin,Manager,PlatformAdmin")]
@rendermode InteractiveServer

<PageTitle>Users — Vaultex Admin</PageTitle>

<div class="apage-header">
    <div>
        <div class="apage-title">Users</div>
        <div class="apage-subtitle">Manage user accounts in this tenant</div>
    </div>
    <button class="abtn abtn--primary" @onclick="() => showCreate = true">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"/></svg>
        New User
    </button>
</div>

<div class="acard">
    <div class="acard-toolbar">
        <div class="asearch-wrap">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/></svg>
            <input class="asearch-input" placeholder="Search email or name..."
                   @bind="search" @bind:event="oninput" @onkeyup="LoadUsers" />
        </div>
    </div>

    @if (loading)
    {
        <div class="atable-loading">
            <div class="atable-spinner"></div>
        </div>
    }
    else if (users.Count == 0)
    {
        <div class="atable-empty">No users found.</div>
    }
    else
    {
        <div class="atable-wrap">
            <table class="atable">
                <thead>
                    <tr>
                        <th>User</th>
                        <th>Status</th>
                        <th>Last Login</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in users)
                    {
                        <tr>
                            <td>
                                <div class="auser-cell">
                                    <div class="auser-avatar">@GetInitials(u.FullName ?? u.Email)</div>
                                    <div>
                                        <div class="auser-name">@(u.FullName ?? "—")</div>
                                        <div class="auser-email">@u.Email</div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="abadge @(u.IsActive ? "abadge--green" : "abadge--gray")">
                                    @(u.IsActive ? "Active" : "Inactive")
                                </span>
                            </td>
                            <td class="atext-muted">@(u.LastLoginAt?.ToString("dd/MM/yyyy HH:mm") ?? "—")</td>
                            <td>
                                <div class="arow-actions">
                                    <button class="abtn-ghost" @onclick="() => ToggleActive(u)">
                                        @(u.IsActive ? "Deactivate" : "Activate")
                                    </button>
                                    <button class="abtn-ghost" @onclick="() => OpenRoles(u)">Roles</button>
                                    <button class="abtn-ghost abtn-ghost--danger" @onclick="() => ConfirmDelete(u)">Delete</button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="apagination">
            <button class="abtn-page" disabled="@(page <= 1)" @onclick="PrevPage">‹ Prev</button>
            <span class="apagination-info">Page @(page) of @(totalPages)</span>
            <button class="abtn-page" disabled="@(page >= totalPages)" @onclick="NextPage">Next ›</button>
        </div>
    }
</div>

@if (showCreate)
{
    <div class="amodal-overlay" @onclick="() => showCreate = false">
        <div class="amodal" @onclick:stopPropagation>
            <div class="amodal-header">
                <div class="amodal-title">Create User</div>
                <button class="amodal-close" @onclick="() => showCreate = false">✕</button>
            </div>
            <div class="amodal-body">
                <div class="aform-field">
                    <label class="aform-label">Email</label>
                    <input class="aform-input" @bind="newEmail" placeholder="user@example.com" />
                </div>
                <div class="aform-field">
                    <label class="aform-label">Full Name</label>
                    <input class="aform-input" @bind="newFullName" placeholder="John Doe" />
                </div>
                <div class="aform-field">
                    <label class="aform-label">Password</label>
                    <input class="aform-input" type="password" @bind="newPassword" placeholder="••••••••" />
                </div>
                <div class="aform-field">
                    <label class="aform-label">Role</label>
                    <select class="aform-input" @bind="newRole">
                        <option value="">— None —</option>
                        @foreach (var r in availableRoles)
                        {
                            <option value="@r">@r</option>
                        }
                    </select>
                </div>
                @if (!string.IsNullOrEmpty(createError))
                {
                    <div class="aform-error">@createError</div>
                }
            </div>
            <div class="amodal-footer">
                <button class="abtn abtn--ghost" @onclick="() => showCreate = false">Cancel</button>
                <button class="abtn abtn--primary" @onclick="CreateUser">Create</button>
            </div>
        </div>
    </div>
}

@if (rolesUser is not null)
{
    <div class="amodal-overlay" @onclick="() => rolesUser = null">
        <div class="amodal" @onclick:stopPropagation>
            <div class="amodal-header">
                <div class="amodal-title">Roles — @rolesUser.Email</div>
                <button class="amodal-close" @onclick="() => rolesUser = null">✕</button>
            </div>
            <div class="amodal-body">
                @foreach (var r in availableRoles)
                {
                    <label class="acheck-label">
                        <input type="checkbox" class="acheck-input"
                               checked="@selectedRoles.Contains(r)"
                               @onchange="e => ToggleRole(r, (bool)e.Value!)" />
                        @r
                    </label>
                }
            </div>
            <div class="amodal-footer">
                <button class="abtn abtn--ghost" @onclick="() => rolesUser = null">Cancel</button>
                <button class="abtn abtn--primary" @onclick="SaveRoles">Save</button>
            </div>
        </div>
    </div>
}

@if (deleteUser is not null)
{
    <div class="amodal-overlay" @onclick="() => deleteUser = null">
        <div class="amodal" @onclick:stopPropagation>
            <div class="amodal-header">
                <div class="amodal-title">Delete User</div>
                <button class="amodal-close" @onclick="() => deleteUser = null">✕</button>
            </div>
            <div class="amodal-body">
                <p class="amodal-text">Are you sure you want to permanently delete <strong>@deleteUser.Email</strong>?</p>
                <p class="amodal-text amodal-text--danger">This action cannot be undone.</p>
            </div>
            <div class="amodal-footer">
                <button class="abtn abtn--ghost" @onclick="() => deleteUser = null">Cancel</button>
                <button class="abtn abtn--danger" @onclick="DeleteUser">Delete</button>
            </div>
        </div>
    </div>
}
