@page "/admin/roles"
@layout AdminLayout
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@rendermode InteractiveServer

<PageTitle>Roles — Vaultex Admin</PageTitle>

<div class="apage-header">
    <div>
        <div class="apage-title">Roles</div>
        <div class="apage-subtitle">@roles.Count role(s) in this tenant</div>
    </div>
    <button class="abtn abtn--primary" @onclick="() => showCreate = true">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"/></svg>
        New Role
    </button>
</div>

<div class="acard">
    @if (loading)
    {
        <div class="atable-loading"><div class="atable-spinner"></div></div>
    }
    else if (roles.Count == 0)
    {
        <div class="atable-empty">No roles found.</div>
    }
    else
    {
        <div class="atable-wrap">
            <table class="atable">
                <thead>
                    <tr>
                        <th>Role Name</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in roles)
                    {
                        <tr>
                            <td><span class="abadge abadge--purple">@r.ShortName</span></td>
                            <td>
                                <div class="arow-actions">
                                    <button class="abtn-ghost abtn-ghost--danger"
                                            @onclick="() => DeleteRole(r.Id)">Delete</button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@if (showCreate)
{
    <div class="amodal-overlay" @onclick="() => showCreate = false">
        <div class="amodal" @onclick:stopPropagation>
            <div class="amodal-header">
                <div class="amodal-title">Create Role</div>
                <button class="amodal-close" @onclick="() => showCreate = false">✕</button>
            </div>
            <div class="amodal-body">
                <div class="aform-field">
                    <label class="aform-label">Role Name</label>
                    <input class="aform-input" @bind="newRoleName" placeholder="e.g. Reviewer" />
                </div>
                @if (!string.IsNullOrEmpty(createError))
                {
                    <div class="aform-error">@createError</div>
                }
            </div>
            <div class="amodal-footer">
                <button class="abtn abtn--ghost" @onclick="() => showCreate = false">Cancel</button>
                <button class="abtn abtn--primary" @onclick="CreateRole">Create</button>
            </div>
        </div>
    </div>
}
