<PageTitle>ASP.NET Core integration — Vaultex</PageTitle>

<div class="docs-eyebrow">Integration guide</div>
<h1>ASP.NET Core</h1>
<p class="docs-lead">
    A complete walkthrough for adding Vaultex to an ASP.NET Core 8+ application. Covers MVC, Razor
    Pages, Blazor Server, and Web API scenarios.
</p>

<h2 id="install">1. Install packages</h2>
<div class="docs-codeblock">
    <div class="docs-codeblock-header">
        <span class="docs-codeblock-lang">Bash</span>
        <button class="docs-codeblock-copy" onclick="vxCopy(this)">Copy</button>
    </div>
<pre><code>dotnet add package Microsoft.AspNetCore.Authentication.OpenIdConnect
dotnet add package Microsoft.AspNetCore.Authentication.JwtBearer</code></pre>
</div>

<h2 id="web-app">2. Configure a web app (cookie + OIDC)</h2>
<p>For server-rendered apps, use the cookie + OIDC combination. The cookie holds the local session, OIDC handles the redirect dance.</p>

<div class="docs-codeblock">
    <div class="docs-codeblock-header">
        <span class="docs-codeblock-lang">C#</span>
        <button class="docs-codeblock-copy" onclick="vxCopy(this)">Copy</button>
    </div>
<pre><code>// Program.cs
using Microsoft.AspNetCore.Authentication.Cookies;
using Microsoft.AspNetCore.Authentication.OpenIdConnect;

builder.Services.AddAuthentication(o =&gt;
{
    o.DefaultScheme         = CookieAuthenticationDefaults.AuthenticationScheme;
    o.DefaultChallengeScheme = OpenIdConnectDefaults.AuthenticationScheme;
})
.AddCookie(o =&gt;
{
    o.ExpireTimeSpan      = TimeSpan.FromHours(8);
    o.SlidingExpiration   = true;
})
.AddOpenIdConnect(o =&gt;
{
    o.Authority    = "https://auth.vaultex.io";
    o.ClientId     = builder.Configuration["Vaultex:ClientId"];
    o.ClientSecret = builder.Configuration["Vaultex:ClientSecret"];
    o.ResponseType = "code";
    o.UsePkce      = true;
    o.SaveTokens   = true;

    o.Scope.Clear();
    o.Scope.Add("openid");
    o.Scope.Add("profile");
    o.Scope.Add("email");
    o.Scope.Add("roles");
    o.Scope.Add("offline_access");

    o.MapInboundClaims = false;
    o.TokenValidationParameters.NameClaimType = "name";
    o.TokenValidationParameters.RoleClaimType = "role";
});

builder.Services.AddAuthorization();

var app = builder.Build();
app.UseAuthentication();
app.UseAuthorization();</code></pre>
</div>

<h2 id="api">3. Configure a Web API (JWT bearer)</h2>
<p>APIs validate access tokens. They don't redirect &mdash; they accept or reject incoming bearer tokens.</p>

<div class="docs-codeblock">
    <div class="docs-codeblock-header">
        <span class="docs-codeblock-lang">C#</span>
        <button class="docs-codeblock-copy" onclick="vxCopy(this)">Copy</button>
    </div>
<pre><code>builder.Services.AddAuthentication("Bearer")
    .AddJwtBearer("Bearer", o =&gt;
    {
        o.Authority = "https://auth.vaultex.io";
        o.Audience  = "your-api-resource";
        o.MapInboundClaims = false;
        o.TokenValidationParameters.NameClaimType = "name";
        o.TokenValidationParameters.RoleClaimType = "role";
    });

builder.Services.AddAuthorization(o =&gt;
{
    o.AddPolicy("CanManageUsers", p =&gt; p.RequireRole("Admin", "Manager"));
});</code></pre>
</div>

<h2 id="protect">4. Protect endpoints</h2>
<div class="docs-codeblock">
    <div class="docs-codeblock-header">
        <span class="docs-codeblock-lang">C#</span>
        <button class="docs-codeblock-copy" onclick="vxCopy(this)">Copy</button>
    </div>
<pre><code>// MVC
[Authorize(Roles = "Admin")]
public class AdminController : Controller { }

// Razor Pages
[Authorize]
public class IndexModel : PageModel { }

// Minimal API
app.MapGet("/me", (ClaimsPrincipal user) =&gt; new
{
    Id    = user.FindFirst("sub")?.Value,
    Name  = user.FindFirst("name")?.Value,
    Roles = user.FindAll("role").Select(c =&gt; c.Value)
}).RequireAuthorization();</code></pre>
</div>

<h2 id="logout">5. Sign out</h2>
<div class="docs-codeblock">
    <div class="docs-codeblock-header">
        <span class="docs-codeblock-lang">C#</span>
        <button class="docs-codeblock-copy" onclick="vxCopy(this)">Copy</button>
    </div>
<pre><code>app.MapGet("/logout", () =&gt; Results.SignOut(
    properties: new AuthenticationProperties { RedirectUri = "/" },
    authenticationSchemes: new[]
    {
        CookieAuthenticationDefaults.AuthenticationScheme,
        OpenIdConnectDefaults.AuthenticationScheme
    }));</code></pre>
</div>

<h2 id="blazor">Blazor Server notes</h2>
<p>
    Blazor Server uses the same cookie + OIDC setup. Add <code>AddCascadingAuthenticationState()</code>
    so <code>&lt;AuthorizeView&gt;</code> works in components, and use <code>[CascadingParameter]
    Task&lt;AuthenticationState&gt;</code> when you need claims in code-behind.
</p>

