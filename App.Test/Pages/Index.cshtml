@page
@model IndexModel
@{
    ViewData["Title"] = "Trang chủ";
}

<section class="hero">
    <h1>Demo bên thứ 3 dùng Vaultex</h1>
    <p>App.Test là một web app nhỏ minh hoạ flow OAuth 2.0 / OpenID Connect với Vaultex IAM.</p>
    <p class="muted">Authority: <code>@Model.Authority</code> &middot; ClientId: <code>@Model.ClientId</code></p>
</section>

@if (User.Identity?.IsAuthenticated == true)
{
    <div class="card">
        <h2>Xin chào, @User.Identity.Name</h2>
        <p class="muted">Bạn đã đăng nhập qua Vaultex. Vào <a asp-page="/Profile">Hồ sơ</a> để xem chi tiết claims và token.</p>
    </div>
}
else
{
    <div class="card">
        <h2>Bạn chưa đăng nhập</h2>
        <p>Bấm <strong>Đăng nhập với Vaultex</strong> để chuyển sang trang đăng nhập của Vaultex, cấp quyền (consent) và quay lại đây.</p>
        <p><a asp-page="/Account/Login" class="btn btn-primary">Đăng nhập với Vaultex</a></p>
    </div>
}

<div class="card">
    <h2>Flow hoạt động</h2>
    <ol>
        <li>Click <em>Đăng nhập</em> &rarr; App.Test redirect sang <code>/connect/authorize</code> của Vaultex.</li>
        <li>Vaultex hiện form đăng nhập, sau đó hiện màn hình consent (vì client này là third-party).</li>
        <li>User cấp quyền &rarr; Vaultex redirect về <code>/signin-oidc</code> kèm authorization code.</li>
        <li>App.Test đổi code lấy access_token + id_token + refresh_token (PKCE + client_secret).</li>
        <li>App.Test set cookie session, hiển thị claims.</li>
    </ol>
</div>
