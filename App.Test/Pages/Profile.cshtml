@page
@model ProfileModel
@{
    ViewData["Title"] = "Hồ sơ";
}

<section class="hero">
    <h1>Hồ sơ người dùng</h1>
    <p class="muted">Thông tin được lấy từ id_token và userinfo endpoint của Vaultex.</p>
</section>

<div class="card">
    <h2>Claims</h2>
    <table class="kvtable">
        <tbody>
            @foreach (var claim in Model.Claims)
            {
                <tr>
                    <th>@claim.Type</th>
                    <td>@claim.Value</td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (!string.IsNullOrEmpty(Model.AccessToken))
{
    <div class="card">
        <h2>Access Token (JWT)</h2>
        <p class="muted">Đây là access_token bên thứ 3 nhận được. Nó là JWS (JWT có chữ ký), có thể verify bằng JWKS của Vaultex.</p>
        <pre class="token">@Model.AccessToken</pre>
    </div>
}

@if (!string.IsNullOrEmpty(Model.IdToken))
{
    <div class="card">
        <h2>ID Token (JWT)</h2>
        <pre class="token">@Model.IdToken</pre>
    </div>
}

@if (!string.IsNullOrEmpty(Model.RefreshToken))
{
    <div class="card">
        <h2>Refresh Token</h2>
        <p class="muted">Token dùng để xin access_token mới khi access_token hết hạn (offline_access scope).</p>
        <pre class="token">@Model.RefreshToken</pre>
    </div>
}
