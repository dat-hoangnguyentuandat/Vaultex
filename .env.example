# Copy this to .env and fill in real values before running docker-compose
POSTGRES_PASSWORD=change_me_in_production
OIDC_CLIENT_SECRET=change_me_in_production

# Email (leave SMTP_HOST empty to log emails to console instead of sending)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=noreply@vaultex.io

# App base URL (used in password reset links)
APP_BASE_URL=http://localhost:7108

# OpenIddict signing/encryption certs (PFX paths inside the container)
# Leave empty to use ephemeral keys (tokens won't survive restarts)
OPENIDDICT_ENCRYPTION_CERT_PATH=
OPENIDDICT_SIGNING_CERT_PATH=
OPENIDDICT_CERT_PASSWORD=
