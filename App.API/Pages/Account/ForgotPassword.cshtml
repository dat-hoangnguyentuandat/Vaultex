@page "/account/forgot-password"
@model App.API.Pages.Account.ForgotPasswordModel
@{
    ViewData["Title"] = "Quên mật khẩu";
}

<div class="auth-logo">
    <img src="/favicon.png" alt="logo" />
    <span class="auth-logo-text">Vaultex</span>
</div>

<div class="auth-card">
    <h1 class="auth-card-title" data-i18n="forgot.title">QUÊN MẬT KHẨU</h1>

    @if (Model.EmailSent)
    {
        <div class="auth-alert-success">
            <span class="auth-alert-icon">✓</span>
            <span class="auth-alert-text" data-i18n="forgot.sent">
                Nếu email tồn tại trong hệ thống, link đặt lại mật khẩu đã được gửi.
                Vui lòng kiểm tra hộp thư.
            </span>
        </div>
        <div style="margin-top: 24px;">
            <a href="/account/login" class="btn-auth-primary" style="display:block;text-align:center;"
               data-i18n="forgot.back">← Quay lại đăng nhập</a>
        </div>
    }
    else
    {
        <p class="auth-desc-p" data-i18n="forgot.description">
            Nhập email đăng ký của bạn để nhận link đặt lại mật khẩu.
        </p>

        <form method="post">
            <div asp-validation-summary="ModelOnly" class="auth-alert-error"
                 style="display:@(!ViewData.ModelState.IsValid ? "flex" : "none")">
            </div>

            <div class="auth-field">
                <label asp-for="Input.Email" data-i18n="forgot.email">Email <span class="required-star">*</span></label>
                <input asp-for="Input.Email"
                       class="auth-input"
                       placeholder="Nhập email của bạn"
                       data-i18n-placeholder="forgot.email.placeholder"
                       type="email" />
                <span asp-validation-for="Input.Email" class="auth-error-msg"></span>
            </div>

            <div style="margin-top: 24px;">
                <button type="submit" class="btn-auth-primary" data-i18n="forgot.submit">Gửi link đặt lại</button>
            </div>
        </form>
        <div class="auth-login-footer">
            <div class="auth-footer-link">
                <a href="/account/login" data-i18n="forgot.back">← Quay lại đăng nhập</a>
            </div>
        </div>
    }
</div>
