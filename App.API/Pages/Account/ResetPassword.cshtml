@page "/account/reset-password"
@model App.API.Pages.Account.ResetPasswordModel
@{
    ViewData["Title"] = "Đặt lại mật khẩu";
}

<div class="auth-logo">
    <img src="/favicon.png" alt="logo" />
    <span class="auth-logo-text">Vaultex</span>
</div>

<div class="auth-card">
    <h1 class="auth-card-title" data-i18n="reset.title">ĐẶT LẠI MẬT KHẨU</h1>

    @if (Model.InvalidLink)
    {
        <div class="auth-alert-error">
            <span class="auth-alert-icon">⚠</span>
            <span class="auth-alert-text" data-i18n="reset.invalid">Link không hợp lệ hoặc đã hết hạn.</span>
        </div>
        <div style="margin-top: 24px;">
            <a href="/account/forgot-password" class="btn-auth-primary" style="display:block;text-align:center;"
               data-i18n="reset.request_new">Yêu cầu link mới</a>
        </div>
    }
    else if (Model.ShowSuccess)
    {
        <div class="auth-alert-success">
            <span class="auth-alert-icon">✓</span>
            <span class="auth-alert-text" data-i18n="reset.success">Mật khẩu đã được đặt lại thành công.</span>
        </div>
        <div style="margin-top: 24px;">
            <a href="/account/login" class="btn-auth-primary" style="display:block;text-align:center;"
               data-i18n="reset.login">Đăng nhập</a>
        </div>
    }
    else
    {
        <p class="auth-desc-p">
            Đặt lại mật khẩu cho <strong>@Model.Email</strong>.
        </p>

        <form method="post">
            <input type="hidden" asp-for="Email" />
            <input type="hidden" asp-for="Token" />

            <div asp-validation-summary="ModelOnly" class="auth-alert-error"
                 style="display:@(!ViewData.ModelState.IsValid ? "flex" : "none")">
            </div>

            <div class="auth-field">
                <label asp-for="Input.NewPassword" data-i18n="reset.new_password">Mật khẩu mới <span class="required-star">*</span></label>
                <input asp-for="Input.NewPassword" type="password" class="auth-input"
                       placeholder="Nhập mật khẩu mới"
                       data-i18n-placeholder="reset.new_password.placeholder" />
                <span asp-validation-for="Input.NewPassword" class="auth-error-msg"></span>
            </div>

            <div class="auth-field">
                <label asp-for="Input.ConfirmPassword" data-i18n="reset.confirm_password">Xác nhận mật khẩu <span class="required-star">*</span></label>
                <input asp-for="Input.ConfirmPassword" type="password" class="auth-input"
                       placeholder="Nhập lại mật khẩu mới"
                       data-i18n-placeholder="reset.confirm_password.placeholder" />
                <span asp-validation-for="Input.ConfirmPassword" class="auth-error-msg"></span>
            </div>

            <div style="margin-top: 24px;">
                <button type="submit" class="btn-auth-primary" data-i18n="reset.submit">Đặt lại mật khẩu</button>
            </div>
        </form>
    }
</div>
