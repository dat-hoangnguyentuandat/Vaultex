{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning",
        "OpenIddict": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext} | {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:7066" ]
  },
  "OpenIddict": {
    "TokenLifetimes": {
      "AccessTokenSeconds": 3600,
      "RefreshTokenDays": 30,
      "AuthorizationCodeMinutes": 5
    },
    "Scopes": [
      { "Name": "email",          "DisplayName": "Email" },
      { "Name": "profile",        "DisplayName": "Profile" },
      { "Name": "roles",          "DisplayName": "Roles" },
      { "Name": "offline_access", "DisplayName": "Offline Access" }
    ],
    "Applications": {
      "AppWeb": {
        "ClientId": "app-web",
        "ClientSecret": "app-web-secret",
        "DisplayName": "App Web Client",
        "RedirectUris": [ "http://localhost:7066/signin-oidc" ],
        "PostLogoutRedirectUris": [ "http://localhost:7066/signout-callback-oidc" ],
        "Requirements": [ "ft:pkce" ],
        "Permissions": [
          "gt:authorization_code",
          "gt:refresh_token",
          "gt:password",
          "rst:code",
          "ept:authorization",
          "ept:token",
          "ept:logout",
          "scp:email",
          "scp:profile",
          "scp:roles",
          "scp:offline_access"
        ]
      }
    }
  }
}
